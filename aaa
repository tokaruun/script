const axios = require('axios');
const fs = require('fs');
const dns = require('dns');
dns.setDefaultResultOrder('ipv4first');

function normalizeName(name) {
    return String(name).replace(/\s+/g, '').toLowerCase();
}

function pushServer(groups, name, entry) {
    const key = normalizeName(name);
    if (!groups[key]) groups[key] = [];
    groups[key].push(entry);
}

function saveToApi(name, dataList) {
    if (!fs.existsSync('api')) fs.mkdirSync('api');
    const fileName = `api/${name}.json`;
    fs.writeFileSync(fileName, JSON.stringify(dataList, null, 2));
    console.log(`Đã lưu ${dataList.length} mục vào ${fileName}`);
}

// --- DISCORD BOT CONFIG ---
const DISCORD_TOKEN = process.env.DISCORD_BOT_TOKEN || '';

const DISCORD_CHANNELS = {
    'castle-raid': process.env.DISCORD_CHANNEL_CASTLE_RAID_ID || '1541832985362300978',
    mirage: process.env.DISCORD_CHANNEL_MIRAGE_ID || '1541832671389417522',
    boss: process.env.DISCORD_CHANNEL_BOSS_ID || '1541832629849038859',
    'full-moon': process.env.DISCORD_CHANNEL_FULL_MOON_ID || '1541832748493447289',
    fruits: process.env.DISCORD_CHANNEL_FRUITS_ID || '1541832908283715714'
};

if (!DISCORD_TOKEN) {
    console.error('Thiếu DISCORD_BOT_TOKEN; scraper không thể đọc Discord channels.');
}

const DISCORD_TYPE_ALIASES = {
    castleraid: 'castle-raid',
    raidcastle: 'castle-raid',
    raid: 'castle-raid',
    fullmoon: 'full-moon',
    fruit: 'fruits'
};

function normalizeDiscordType(name) {
    const normalized = normalizeName(name);
    if (DISCORD_TYPE_ALIASES[normalized]) return DISCORD_TYPE_ALIASES[normalized];
    if (normalized.includes('mirage')) return 'mirage';
    if (normalized.includes('pirateraid') || normalized.includes('castleonthesea')) return 'castle-raid';
    if (normalized.includes('boss') || normalized.includes('cakeprince') || normalized.includes('cakequeen') || normalized.includes('cursedcaptain')) return 'boss';
    if (normalized.includes('fullmoon')) return 'full-moon';
    if (normalized.includes('fruit')) return 'fruits';
    return normalized;
}

function getEmbedField(embed, ...labels) {
    const normalizedLabels = labels.map(normalizeName);
    const field = (embed.fields || []).find(item => {
        const fieldName = normalizeName(item.name || '');
        return normalizedLabels.some(label => fieldName.includes(label));
    });
    return field?.value || '';
}

function cleanFieldValue(value) {
    return String(value || '')
        .replace(/```[a-zA-Z]*\s*/g, '')
        .replace(/```/g, '')
        .trim();
}

function getJobId(value) {
    const match = cleanFieldValue(value).match(/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/i);
    return match ? match[0] : cleanFieldValue(value);
}

function getPlayers(value) {
    const match = cleanFieldValue(value).match(/\d+/);
    return match ? Number.parseInt(match[0], 10) : 0;
}

function getPlaceId(embed) {
    const value = getEmbedField(embed, 'Place ID', 'PlaceId', 'Game ID', 'Universe ID');
    const match = cleanFieldValue(value).match(/\d{5,}/);
    return match ? match[0] : cleanFieldValue(value);
}

function getEventType(channelType, embed) {
    const title = normalizeDiscordType(embed.title || '');
    if (channelType === 'boss') return normalizeName(getEmbedField(embed, 'Boss Name')) || 'boss';
    if (channelType === 'fruits') return 'fruit';
    if (channelType === 'castle-raid') return 'raidcastle';
    if (channelType === 'mirage') return 'mirage';
    if (channelType === 'full-moon') return 'fullmoon';
    return title || channelType;
}

// Delay để tránh rate limit
function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

async function readChannel(channelType, channelId) {
    if (!DISCORD_TOKEN || !channelId) return {};

    try {
        const response = await axios.get(
            `https://discord.com/api/v9/channels/${encodeURIComponent(channelId)}/messages?limit=100`,
            {
                headers: { Authorization: `Bot ${DISCORD_TOKEN}` },
                timeout: 15000
            }
        );

        const groups = {};
        for (const message of response.data || []) {
            for (const embed of message.embeds || []) {
                const jobId = getJobId(getEmbedField(embed, 'Join Code', 'Job ID', 'JobId', 'Server ID'));
                if (!jobId) continue;

                const type = getEventType(channelType, embed);
                const placeId = getPlaceId(embed);
                const players = getPlayers(getEmbedField(embed, 'Player Count', 'Players', 'Player'));
                pushServer(groups, type, {
                    jobId,
                    ...(placeId ? { placeId } : {}),
                    players,
                    updatedAt: Date.now()
                });
            }
        }
        return groups;
    } catch (e) {
        const status = e.response?.status;
        if (status === 401) {
            console.error(`[${channelType}] Token không hợp lệ hoặc đã hết hạn!`);
        } else if (status === 403) {
            console.error(`[${channelType}] Không có quyền đọc channel này!`);
        } else if (status === 429) {
            const retryAfter = e.response?.data?.retry_after || 5;
            console.warn(`[${channelType}] Rate limit! Đợi ${retryAfter}s...`);
            await sleep(retryAfter * 1000);
        } else {
            console.error(`[${channelType}] Lỗi: ${status || e.message}`);
        }
        return {};
    }
}

let running = false;

async function updateAll() {
    running = true;
    try {
        const allGroups = {};

        for (const [channelType, channelId] of Object.entries(DISCORD_CHANNELS)) {
            try {
                const channelGroups = await readChannel(channelType, channelId);
                for (const [name, servers] of Object.entries(channelGroups)) {
                    allGroups[name] = servers;
                }
                // Delay giữa các channel để tránh rate limit
                await sleep(1000);
            } catch (e) {
                console.error(`Lỗi đọc channel ${channelType}:`, e.message);
            }
        }

        for (const name in allGroups) {
            saveToApi(name, allGroups[name]);
        }

        console.log('--- Đã đọc xong Discord channels! ---');
    } finally {
        running = false;
    }
}

setInterval(() => {
    if (running) return;
    updateAll().catch(e => console.error("updateAll lỗi:", e.message));
}, 10000); // 10s thay vì 5s để tránh rate limit

updateAll().catch(e => console.error("updateAll lỗi:", e.message));
